{
  "version": "0.1.0",
  "nodeModulesDir": "auto",
  "tasks": {
    "dev": "deno task css:watch & deno task bundle:watch & deno run -A --watch src/server/main.ts",
    "start": "deno run -A src/server/main.ts",
    "mcp": "deno run --allow-read --allow-write --allow-env --allow-run=git src/mcp/server.ts",
    "css": "deno run -A zuke.ts css",
    "css:watch": "deno run -A npm:@tailwindcss/cli -i src/client/styles/app.css -o static/app.css --watch",
    "bundle": "deno run -A zuke.ts bundle",
    "check": "deno run -A zuke.ts check",
    "test": "deno run -A zuke.ts test",
    "bundle:watch": "deno bundle --platform=browser --watch -o static/client.js src/client/main.tsx",
    "build": "deno run -A zuke.ts build",
    "seed": "deno run -A scripts/seed.ts",
    "ci": "deno run -A zuke.ts ci",
    "zuke": "deno run -A zuke.ts"
  },
  "imports": {
    "@types/d3-selection": "npm:@types/d3-selection@^3.0.12",
    "@types/d3-zoom": "npm:@types/d3-zoom@^3.0.9",
    "d3-selection": "npm:d3-selection@^3.0.0",
    "d3-zoom": "npm:d3-zoom@^3.0.0",
    "dompurify": "npm:dompurify@^3.4.17",
    "hono": "jsr:@hono/hono@^4.13.13",
    "hono/deno": "jsr:@hono/hono@^4.13.13/deno",
    "qrcode-terminal": "npm:qrcode-terminal@^0.12.0",
    "marked": "npm:marked@^18.1.1",
    "preact": "npm:preact@^11.0.1",
    "preact/hooks": "npm:preact@^11.0.1/hooks",
    "@preact/signals": "npm:@preact/signals@^2.11.3",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@modelcontextprotocol/sdk/": "npm:/@modelcontextprotocol/sdk@^1.32.1/",
    "zod": "npm:zod@^4.6.7",
    "@std/assert": "jsr:@std/assert@^1",
    "@std/testing/": "jsr:@std/testing@^1/",
    "@zuke/core": "jsr:@zuke/core@^1.73.0",
    "@zuke/core/shell": "jsr:@zuke/core@^1.73.0/shell",
    "@zuke/deno": "jsr:@zuke/deno@^1.4.2"
  },
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "deno.window",
      "dom",
      "dom.iterable"
    ]
  },
  "lint": {
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "exclude": [
      "design",
      "node_modules",
      "static",
      "examples"
    ]
  },
  "fmt": {
    "lineWidth": 100,
    "semiColons": true,
    "exclude": [
      "android",
      "design",
      "node_modules",
      "static",
      "examples"
    ]
  },
  "exclude": [
    "static/app.css",
    "dist",
    "node_modules"
  ]
}
